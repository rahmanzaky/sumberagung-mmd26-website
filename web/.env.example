# Google OAuth — buat di https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WAJIB diisi — tanpa ini NextAuth melempar "MissingSecret" di setiap request.
# Generate dengan: openssl rand -base64 32
# Simpan hasilnya di .env.local (BUKAN di sini)
# NextAuth v5 memakai AUTH_SECRET; NEXTAUTH_SECRET masih dibaca sebagai fallback.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# URL backend Apps Script — SATU Web App untuk semua endpoint.
# Deploy Code.gs (lihat docs/panduan-deploy-appscript.md) lalu tempel URL /exec.
# Kosong = seluruh modul memakai data contoh (website tetap jalan).
APPS_SCRIPT_URL=
