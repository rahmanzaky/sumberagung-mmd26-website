# Google OAuth — buat di https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WAJIB diisi — tanpa ini NextAuth melempar "MissingSecret" di setiap request.
# Generate dengan: openssl rand -base64 32
# Simpan hasilnya di .env.local (BUKAN di sini)
# NextAuth v5 memakai AUTH_SECRET; NEXTAUTH_SECRET masih dibaca sebagai fallback.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# URL Google Apps Script Web App — isi setelah deploy Apps Script
# Lihat apps-script/README.md untuk cara deploy
APPS_SCRIPT_BUKU_TAMU_URL=
APPS_SCRIPT_SURAT_URL=
APPS_SCRIPT_PRESENSI_URL=
APPS_SCRIPT_KEPENDUDUKAN_URL=
APPS_SCRIPT_PENGGUNA_URL=
APPS_SCRIPT_KONTEN_URL=
APPS_SCRIPT_GALERI_URL=
APPS_SCRIPT_PENGATURAN_URL=
