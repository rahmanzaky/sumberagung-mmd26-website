# Google OAuth — buat di https://console.cloud.google.com
GOOGLE_CLIENT_ID=879761782254-lp3j1psl8hm03j4hkaca085fnnatec0g.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# WAJIB diisi — tanpa ini NextAuth melempar "MissingSecret" di setiap request.
# Generate dengan: openssl rand -base64 32
# Simpan hasilnya di .env.local (BUKAN di sini)
# NextAuth v5 memakai AUTH_SECRET; NEXTAUTH_SECRET masih dibaca sebagai fallback.
AUTH_SECRET=sumberagungpanggungrejo 
NEXTAUTH_URL=http://localhost:3000

# URL Google Apps Script Web App — isi setelah deploy Code.gs
# Satu URL untuk semua resource (bukuTamu, surat, absensi, dll.)
# Lihat docs/panduan-deploy-appscript.md untuk cara deploy
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbywI5VftGzSlhFVfbsZCb4CDgceYsMoy9Bo8QeFJpRgs2ovt-Ugulu9oQZIOr3hB5R_3w/exec
